[resource]
script = ExtResource("1_skilldata")
id = &"skill_athena_aegis_of_medusa"
display_name = "Aegis of Medusa"
cast_range = 60.0
values = {
&"god_stun": 0.5,
&"shield_duration": 4.0,
&"shield_hp_pct": 30.0,
&"stun_radius": 60.0,
&"unit_stun": 1.0
}
description_template = "Raises the Aegis, gaining a shield equal to {shield_hp_pct}% of her max HP for {shield_duration}s. When the shield breaks or fades, the Gorgon's head flashes: nearby enemy units are stunned for {unit_stun}s and the enemy god for {god_stun}s."
